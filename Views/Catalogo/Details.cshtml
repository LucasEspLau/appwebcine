@model appwebcine.Models.Producto

@{
    ViewData["Title"] = "Detalles de la Película";
}

<div class="container">
    <h1>@ViewData["Title"]</h1>

    <div class="row">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.ImagenURL))
            {
                <img src="@Model.ImagenURL" class="img-fluid" alt="Imagen de @Model.Nombre">
            }
        </div>
        <div class="col-md-8">
            <h2>@Model.Nombre</h2>
            <p><strong>Descripción:</strong> @Model.Descripcion</p>
            <p><strong>Precio:</strong> @Model.Precio.ToString()</p>
        </div>
    </div>

    <a href="@Url.Action("Index")" class="btn btn-primary mt-3">Volver a la lista</a>
</div>
